COMPOSE_PROJECT_NAME=sylo
# Nom d'hote seul (pas d'URL, pas de slash), ex: wakaru-api.diatem.local ou api.mondomaine.fr
COMPOSE_PROJECT_HOST=''
COMPOSE_PROJECT_PORT=8000
COMPOSE_SYLO_VERSION='0.0'
COMPOSE_RESTART_POLICY='no'
# Point d'entree Traefik : "http" en local, "https" sur le VPS (Let's Encrypt)
COMPOSE_TRAEFIK_ENTRYPOINT=http
