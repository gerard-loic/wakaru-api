{% extends "gabarit.j2" %}

{% block content %}
  <p style="margin: 0 0 16px; font-size: 20px; font-weight: bold; color: #000000;">Bonjour {{ name }},</p>
  <p style="margin: 0 0 16px;">Un compte <strong style="color: #ff6600;">Wakaru</strong> vient d'être créé pour vous. Wakaru vous accompagne dans l'apprentissage du japonais : kana, kanji, vocabulaire et grammaire.</p>
  <p style="margin: 0 0 24px;">Pour activer votre compte, il ne vous reste qu'à choisir votre mot de passe :</p>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto 24px;">
    <tr>
      <td align="center" style="background-color: #e65c00; border-radius: 6px;">
        <a href="{{ password_url }}" style="display: inline-block; padding: 14px 28px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff; text-decoration: none;">Choisir mon mot de passe</a>
      </td>
    </tr>
  </table>
  <p style="margin: 0 0 16px; font-size: 13px; color: #666666;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br><a href="{{ password_url }}" style="color: #c24e00; word-break: break-all;">{{ password_url }}</a></p>
  <p style="margin: 0 0 16px; font-size: 13px; color: #666666;">Vous n'êtes pas à l'origine de cette demande ? Vous pouvez ignorer cet email.</p>
  <p style="margin: 0;">À très bientôt,<br>L'équipe Wakaru</p>
{% endblock %}
