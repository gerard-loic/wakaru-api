<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body style="margin: 0; padding: 0; background-color: #ffffff;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; background-color: #ffffff;">
            {# Logo PNG de 560px affiché à 200px pour rester net sur écrans haute densité. #}
            <tr>
              <td align="center" style="padding: 8px 24px 20px; border-bottom: 3px solid #ff6600;">
                <a href="{{ site_url }}" style="display: inline-block; text-decoration: none;"><img src="cid:header_logo" alt="Wakaru" width="200" style="display: block; width: 200px; max-width: 100%; height: auto; border: 0;"></a>
              </td>
            </tr>
            <tr>
              <td style="padding: 32px 24px 24px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.6; color: #1a1a1a;">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 16px 24px; border-top: 1px solid #eeeeee; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.5; color: #888888;">
                <p style="margin: 0 0 4px;"><strong style="color: #ff6600;">Wakaru</strong> · 分かる, « j'ai compris »</p>
                <p style="margin: 0 0 4px;"><a href="{{ site_url }}" style="color: #c24e00; text-decoration: none;">{{ site_url.split('://')[-1] }}</a></p>
                <p style="margin: 0;">Cet email vous a été envoyé automatiquement, merci de ne pas y répondre.</p>
                {% block footer_extra %}{% endblock %}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
