# =============================================================================
# Application
# =============================================================================
# Mode debug. Attention : cette clé n'est lue nulle part dans le code actuel (ni
# Sylo, ni custom/), elle n'a donc aucun effet.
SYLO_DEBUG=true
# URL publique du site (sans slash final), utilisée dans les liens des emails.
WAKARU_SITE_URL=https://wakaru.fr

# =============================================================================
# Base de données
# =============================================================================
# Chaîne de connexion SQLAlchemy à la base PostgreSQL.
SYLO_DATABASE_URL=postgresql+psycopg2://sylo:sylo@localhost:5432/sylo

# =============================================================================
# Pagination de l'API
# =============================================================================
# Nombre d'éléments renvoyés par défaut par les routes de liste (paramètre `limit`).
SYLO_DEFAULT_PAGE_SIZE=50
# Valeur maximale acceptée pour `limit`.
SYLO_MAX_PAGE_SIZE=200

# =============================================================================
# Emails (SMTP)
# =============================================================================
# Adresse et port du serveur SMTP.
SYLO_SMTP_HOST=localhost
SYLO_SMTP_PORT=587
# Identifiants SMTP. Utilisateur vide = envoi sans authentification.
SYLO_SMTP_USER=
SYLO_SMTP_PASSWORD=
# Chiffrement par STARTTLS après connexion (ignoré si SYLO_SMTP_USE_SSL=true).
SYLO_SMTP_USE_TLS=true
# Connexion chiffrée en SSL dès l'ouverture (généralement sur le port 465).
SYLO_SMTP_USE_SSL=false
# Adresse et nom de l'expéditeur des emails.
SYLO_MAIL_FROM_ADDRESS=no-reply@sylo.local
SYLO_MAIL_FROM_NAME=Wakaru

# =============================================================================
# Authentification
# =============================================================================
# Coût du hashage bcrypt des mots de passe (facteur de travail, plus haut = plus lent/sûr).
SYLO_PASSWORD_HASH_ROUNDS=12
# Durée de validité d'un token d'authentification (POST /users/login), en minutes.
SYLO_AUTH_TOKEN_TTL_MINUTES=1440
# Préfixe de l'URL envoyée par mail pour choisir son mot de passe (POST /users sans
# `password` : un token est généré et ajouté à la suite de ce préfixe, ex. token=abc).
SYLO_PASSWORD_SETUP_URL_PREFIX=http://monsite.fr/choixmotdepasse?token=

# =============================================================================
# Mot de passe oublié (POST /users/forgot-password puis /users/reset-password)
# =============================================================================
# Secret de signature des tokens, à générer avec `openssl rand -hex 32`. Vide = aucun
# mail envoyé et tout token refusé. Le changer invalide les liens en cours.
WAKARU_PASSWORD_RESET_SECRET=
# Préfixe de l'URL envoyée par mail : le token est ajouté à la suite.
WAKARU_PASSWORD_RESET_URL_PREFIX=http://monsite.fr/reinitialisationmotdepasse?token=
# Durée de validité du lien, en minutes.
WAKARU_PASSWORD_RESET_TTL_MINUTES=60

# =============================================================================
# Captcha d'inscription (POST /users/register)
# =============================================================================
# Clé secrète du fournisseur (Cloudflare Turnstile par défaut). Vide = inscriptions
# refusées. Clés de test Cloudflare : secret toujours valide
# 1x0000000000000000000000000000000AA, toujours invalide
# 2x0000000000000000000000000000000AA.
WAKARU_CAPTCHA_SECRET=
# URL de vérification du jeton. hCaptcha/reCAPTCHA : changer cette URL.
WAKARU_CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# =============================================================================
# Médias (images de thème...)
# =============================================================================
# Dossier de stockage des fichiers importés (relatif au dossier de lancement, /app en Docker).
WAKARU_MEDIA_DIR=media
# Chemin sur lequel les fichiers sont servis publiquement, sans authentification.
WAKARU_MEDIA_URL_PATH=/media
# URL publique de l'API (sans slash final), utilisée pour construire l'URL des médias.
WAKARU_MEDIA_BASE_URL=http://wakaru-api.diatem.local
# Taille maximale d'un fichier téléchargé, en octets.
WAKARU_MEDIA_MAX_SIZE=10485760

# =============================================================================
# Apprentissage
# =============================================================================
# Classement des user_knowledge (clé "type" renvoyée avec with_knowledge=true) :
# encours sous WAKARU_KNOWLEDGE_MIN_ATTEMPTS réponses, puis maitrise si
# corrects/mistakes >= WAKARU_KNOWLEDGE_MIN_RATIO, sinon arevoir.
WAKARU_KNOWLEDGE_MIN_ATTEMPTS=5
WAKARU_KNOWLEDGE_MIN_RATIO=2.0
# Nombre d'exercices proposés chaque jour dans le programme d'un thème (7 jours, stocké
# dans `details` du user_knowledge du thème).
WAKARU_PROGRAM_EXERCISES_PER_DAY=3

# =============================================================================
# Serveur MCP
# =============================================================================
# Monte un serveur MCP (Streamable HTTP) sur /mcp, en plus de l'API REST (voir
# "Serveur MCP (optionnel)" dans le README). Désactivé par défaut.
SYLO_MCP_ENABLED=false
# Fichier optionnel listant les routes à ne pas exposer comme outils MCP (même
# syntaxe que --exclude-file dans scripts/sync_permissions.py).
SYLO_MCP_EXCLUDE_FILE=
